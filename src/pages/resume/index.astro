---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ResumeDocument from "../../components/ResumeDocument.astro";
---
<BaseLayout title="Resume" description="Resume and professional experience.">
  <header class="resume-actions wrap">
    <h1>Resume<span aria-hidden="true">.</span></h1>
    <button type="button" data-print-resume>Print / Save PDF ↗</button>
  <script>document.querySelector("[data-print-resume]")?.addEventListener("click", () => window.print());</script>
  </header>
  <div class="wrap"><ResumeDocument /></div>
</BaseLayout>
<style>
  .resume-actions { display:flex; align-items:end; justify-content:space-between; gap:var(--space-4); padding-top:var(--space-12); padding-bottom:var(--space-4); border-bottom:1px solid var(--color-rule); }
  h1 { font-family:var(--font-mono); font-size:clamp(2rem,5vw,3.5rem); letter-spacing:-.06em; }
  h1 span { color:var(--color-accent); }
  button { padding:var(--space-3) var(--space-4); border:1px solid var(--color-accent); background:transparent; color:var(--color-accent); font:inherit; cursor:pointer; }
  button:hover { background:var(--color-accent); color:var(--color-accent-fg); }
  @media print { .resume-actions { display:none; } }
</style>
