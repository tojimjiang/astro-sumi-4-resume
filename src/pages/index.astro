---
import FluidInk from "../components/FluidInk.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { INK, SITE, BLOG } from "../config";
---

<BaseLayout overlayHeader>
  <FluidInk variant="hero" enabled={INK.hero}>
    <div class="hero">
      <p class="hero__eyebrow">Resume · Selected work</p>
      <h1 class="hero__title">{SITE.title}</h1>
      <p class="hero__lede">{SITE.tagline}</p>
      <p class="hero__description">{SITE.description}</p>
      <p class="hero__cta">
        <a href="/resume/">View resume <span aria-hidden="true">↗</span></a>
        {BLOG.enabled && <a class="hero__secondary" href="/blog/">Read notebook <span aria-hidden="true">↗</span></a>}
      </p>
    </div>
  </FluidInk>
  {INK.divider && <FluidInk variant="divider" strength={INK.strength * 0.7}><p class="divider__label label">Selected work</p></FluidInk>}
</BaseLayout>

<style>
  .hero { display:flex; flex:1; flex-direction:column; align-items:center; justify-content:center; gap:var(--space-6); padding:var(--space-24) var(--gutter); text-align:center; }
  .hero__eyebrow { font-family:var(--font-mono); font-size:var(--text-xs); letter-spacing:var(--tracking-wide); text-transform:uppercase; color:var(--color-accent); }
  .hero__title { font-family:var(--font-mono); font-size:var(--text-hero); font-weight:600; line-height:.9; letter-spacing:var(--tracking-hero); text-transform:uppercase; }
  .hero__lede { max-width:36rem; font-size:var(--text-md); color:var(--color-fg-muted); }
  .hero__description { max-width:40rem; color:var(--color-fg-muted); }
  .hero__cta { display:flex; flex-wrap:wrap; justify-content:center; gap:var(--space-4); }
  .hero__cta a { display:inline-block; padding:var(--space-3) var(--space-6); border:var(--rule-width) solid var(--color-accent); border-radius:var(--radius); font-family:var(--font-mono); font-size:var(--text-sm); letter-spacing:var(--tracking-label); text-transform:uppercase; text-decoration:none; color:var(--color-accent); transition:background var(--duration-fast) var(--ease-out),color var(--duration-fast) var(--ease-out); }
  .hero__cta a:hover { background:var(--color-accent); color:var(--color-accent-fg); }
  .hero__cta .hero__secondary { border-color:var(--color-rule); color:var(--color-fg-muted); }
  .divider__label { margin:auto; text-align:center; }
</style>
