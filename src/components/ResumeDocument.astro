---
import resume from "../data/resume.json";
const { person, experience, education, skills } = resume;
---
<article class="resume" aria-label="Resume">
  <header class="masthead">
    <div>
      <h1>{person.name}</h1>
      <p class="headline">{person.headline}</p>
      <p class="meta">{[person.location, person.website, person.linkedin, person.github].filter(Boolean).join(" · ")}</p>
    </div>
  </header>
  {person.summary && <section><h2>Profile</h2><p>{person.summary}</p></section>}
  <section>
    <h2>Experience</h2>
    {experience.map((job) => <article class="entry">
      <div class="entry-heading">
        <div><h3>{job.role}</h3><p class="company">{job.company}{job.location ? ` · ${job.location}` : ""}</p></div>
        <p class="dates">{job.start} — {job.end}</p>
      </div>
      <ul>{job.bullets.map((bullet) => <li>{bullet}</li>)}</ul>
    </article>)}
  </section>
  {education.length > 0 && <section>
    <h2>Education</h2>
    {education.map((item) => <article class="entry">
      <div class="entry-heading">
        <div><h3>{item.qualification}</h3><p class="company">{item.institution}</p>{item.details && <p>{item.details}</p>}</div>
        <p class="dates">{item.start}{item.end ? ` — ${item.end}` : ""}</p>
      </div>
    </article>)}
  </section>}
  {skills.length > 0 && <section><h2>Skills</h2><ul class="skills">{skills.map((skill) => <li>{skill}</li>)}</ul></section>}
</article>
<style>
  .resume { margin:var(--space-8) auto var(--space-16); max-width:8.5in; border-top:3px solid var(--color-fg); color:var(--color-fg); }
  .masthead { padding-block:var(--space-8); border-bottom:1px solid var(--color-rule); }
  h1 { font-family:var(--font-mono); font-size:clamp(2rem,5vw,3.5rem); font-weight:500; letter-spacing:-.06em; line-height:1; }
  .headline { margin-top:var(--space-3); font-size:var(--text-lg); color:var(--color-accent); }
  .meta { margin-top:var(--space-2); color:var(--color-fg-muted); font-size:var(--text-sm); overflow-wrap:anywhere; }
  section { padding-top:var(--space-8); }
  h2 { padding-bottom:var(--space-3); border-bottom:1px solid var(--color-rule); font-family:var(--font-mono); font-size:var(--text-lg); font-weight:500; text-transform:uppercase; letter-spacing:var(--tracking-label); }
  section > p { padding-top:var(--space-4); color:var(--color-fg-muted); line-height:1.55; }
  .entry { padding-block:var(--space-4); border-bottom:1px solid var(--color-rule); break-inside:avoid; }
  .entry-heading { display:flex; align-items:baseline; justify-content:space-between; gap:var(--space-4); }
  h3 { font-size:var(--text-md); font-weight:650; }
  .company,.dates { color:var(--color-fg-muted); font-size:var(--text-sm); }
  .dates { flex-shrink:0; font-family:var(--font-mono); }
  .entry ul { display:grid; gap:var(--space-2); padding:var(--space-3) 0 0 1.2rem; color:var(--color-fg-muted); line-height:1.5; }
  li::marker { color:var(--color-accent); }
  .skills { display:flex; flex-wrap:wrap; gap:var(--space-2); padding-top:var(--space-4); list-style:none; }
  .skills li { padding:.25rem .5rem; border:1px solid var(--color-rule); font-family:var(--font-mono); font-size:var(--text-sm); }
  @media(max-width:42rem) { .entry-heading { flex-direction:column; gap:.25rem; } }
  @media print {
    @page { size:Letter; margin:.4in; }
    :global(html),:global(body) { background:#fff!important; color:#111!important; }
    :global(.site-header),:global(.site-footer),:global(.skip-link),:global(.resume-actions) { display:none!important; }
    :global(main),:global(.wrap) { margin:0!important; padding:0!important; max-width:none!important; }
    .resume { margin:0; border-color:#111; --space-8:12pt; --space-4:6pt; --space-3:4pt; }
    .headline,li::marker { color:#8f211d!important; }
    .meta,.company,.dates,.entry ul,section>p { color:#333!important; }
    .entry,section { break-inside:avoid; }
    * { -webkit-print-color-adjust:exact; print-color-adjust:exact; }
  }
</style>
